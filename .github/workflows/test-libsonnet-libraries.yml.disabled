name: Test Libsonnet Libraries

on:
  workflow_dispatch:
    inputs:
      benchRevision:
        description: 'Bench revision to test (e.g., v0.8.0, experimental)'
        required: true
        default: 'experimental'
  workflow_call:
    inputs:
      benchRevision:
        description: 'Bench revision to test'
        required: true
        type: string

jobs:
  trigger-argo-test:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      actions: read
    
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Get commit info
        id: commit-info
        run: |
          echo "commit=$(git rev-parse HEAD)" >> $GITHUB_OUTPUT
          echo "commit_author=$(git log -1 --pretty=format:'%an')" >> $GITHUB_OUTPUT
          echo "commit_link=https://github.com/${{ github.repository }}/commit/$(git rev-parse HEAD)" >> $GITHUB_OUTPUT

      - name: Trigger Argo Workflow
        uses: grafana/shared-workflows/actions/trigger-argo-workflow@main
        with:
          argo-server-url: https://argo-workflows.grafana.net
          namespace: grafana-bench-cd
          workflow-template: bench-library-test
          parameters: |
            benchRevision=${{ inputs.benchRevision }}
            libsonnetVersion=${{ inputs.benchRevision }}
            triggerRepo=grafana-bench
            commit=${{ steps.commit-info.outputs.commit }}
            commit_author=${{ steps.commit-info.outputs.commit_author }}
            commit_link=${{ steps.commit-info.outputs.commit_link }}
          github-token: ${{ secrets.GITHUB_TOKEN }}
          argo-token: ${{ secrets.ARGO_WORKFLOWS_TOKEN }}

  trigger-experimental-test:
    runs-on: ubuntu-latest
    if: ${{ inputs.benchRevision == 'experimental' }}
    permissions:
      contents: read
      actions: read
    
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Get commit info
        id: commit-info
        run: |
          echo "commit=$(git rev-parse HEAD)" >> $GITHUB_OUTPUT
          echo "commit_author=$(git log -1 --pretty=format:'%an')" >> $GITHUB_OUTPUT
          echo "commit_link=https://github.com/${{ github.repository }}/commit/$(git rev-parse HEAD)" >> $GITHUB_OUTPUT

      - name: Trigger Experimental Argo Workflow
        uses: grafana/shared-workflows/actions/trigger-argo-workflow@main
        with:
          argo-server-url: https://argo-workflows.grafana.net
          namespace: grafana-bench-cd
          workflow-template: bench-experimental-test
          parameters: |
            benchRevision=experimental
            libsonnetVersion=experimental
            triggerRepo=grafana-bench
            commit=${{ steps.commit-info.outputs.commit }}
            commit_author=${{ steps.commit-info.outputs.commit_author }}
            commit_link=${{ steps.commit-info.outputs.commit_link }}
          github-token: ${{ secrets.GITHUB_TOKEN }}
          argo-token: ${{ secrets.ARGO_WORKFLOWS_TOKEN }}
