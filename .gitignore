# ignore directory where we're doing all the work and setting stuff up
!work/grafanaTemplate/
work
creds/*
grafana-bench.tar.gz
.env*


argo.sh

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# don't keep GCP keys
creds/**
GCP-*
custom.ini
# don't keep anything in the test results output
summary/*
*.tfstate
*.tfstate.backup
infra/.terraform/providers
terraform/

# don't add app-sdk generated
local/generated
vendor/
plugin/node_modules/
