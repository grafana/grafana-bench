# ignore directory where we're doing all the work and setting stuff up
!work/grafanaTemplate/
work
creds/*
scratch
grafana-bench.tar.gz
.env*
.DS_Store
test-repo/**
infra_back

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# don't keep GCP keys
creds/**
infra/simulation_service_account_key.json
GCP-*
custom.ini

# don't keep anything in the test results output
summary/*
*.tfstate
*.tfstate.backup
infra/.terraform/providers
terraform/

# don't add app-sdk generated
local/generated
vendor/
plugin/node_modules/

# don't add stuff related to enghub testing
node_modules/
package-lock.json
yarn.lock
package.json
site/

# playwright output from tests
CI/plugin-e2e/playwright
CI/plugin-e2e/node_modules
CI/plugin-e2e/test-results
